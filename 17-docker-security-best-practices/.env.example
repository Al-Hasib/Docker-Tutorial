# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env itself is gitignored on purpose — it's where any real secrets would
# live locally. This example file (safe, no real secrets) is what's committed
# so everyone knows which variables exist.

POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes

REDIS_PORT=6379
CACHE_TTL_SECONDS=10

FLASK_DEBUG=false

# NOTE: POSTGRES_HOST and REDIS_HOST are NOT set here on purpose. They're
# determined by the Docker Compose network topology (the service names
# "db" and "cache"), not by whoever deploys the app — so they're set
# directly in docker-compose.yml instead. Keep "which host to connect to"
# separate from "what to connect with."
